generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// وثائق التحقق - شهادات ووثائق صادرة من نظام شهّر
model Document {
  id         String    @id @default(cuid())
  refNumber  String    @unique // الرقم المرجعي للوثيقة
  fullName   String // الاسم الكامل
  idNumber   String // رقم الهوية / الإقامة
  nationality String?
  docType    String // نوع الوثيقة
  docTitle   String? // عنوان الوثيقة / اسم الدورة
  issueDate  DateTime // تاريخ الإصدار
  expiryDate DateTime? // تاريخ الانتهاء
  status     String    @default("سارية") // سارية | منتهية | ملغاة
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
